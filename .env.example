# Database connection string (Postgres via docker-compose for dev)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/payload

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob (almacenamiento de media). Déjalo vacío en local para usar disco
BLOB_READ_WRITE_TOKEN=

# Enlaces a redes (si están vacíos, los botones no se muestran en el footer)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Correo de contacto que aparece en la política de privacidad (opcional)
NEXT_PUBLIC_CONTACT_EMAIL=

# Aviso por correo al recibir un mensaje (Resend). Si falta alguno, no se envía.
# CONTACT_TO_EMAIL admite varias direcciones separadas por coma.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (antispam). Si están vacías, solo se usa el honeypot + límites.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
